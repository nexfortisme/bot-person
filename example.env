# This file is an example of the .env file that should be created in the root directory of the project.
# Rename this file to .env and fill in the values for the variables.
OPEN_AI_API_KEY=
DISCORD_API_KEY=
DEV_DISCORD_API_KEY=
PERPLEXITY_API_KEY=

BOT_OPEN_AI_MODEL=
OPEN_AI_MODEL=
IMAGE_GENERATION_MODEL=

# Local LLM (/bot, retort machine) — OpenAI-compatible API (e.g. Ollama)
LOCAL_LLM_MODEL=gemma4:12b
RETORT_MACHINE_MODEL=gemma4:12b
# Use http://host.docker.internal:11434/v1/chat/completions when running via Docker
LOCAL_LLM_CHAT_COMPLETIONS_ENDPOINT=http://localhost:11434/v1/chat/completions

ADMINS=
