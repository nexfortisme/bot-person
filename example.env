# This file is an example of the .env file that should be created in the root directory of the project.
# Rename this file to .env and fill in the values for the variables.
OPEN_AI_API_KEY=
OPENROUTER_API_KEY=
DISCORD_API_KEY=
DEV_DISCORD_API_KEY=
PERPLEXITY_API_KEY=

# OpenRouter model slugs. A bare id such as gpt-5.4 is sent as openai/gpt-5.4.
BOT_OPEN_AI_MODEL=openai/gpt-5.4
OPEN_AI_MODEL=openai/gpt-5.4
# Image generation uses GPT Image 2.6 Sunburst unless this is another image model.
IMAGE_GENERATION_MODEL=openai/gpt-image-2.6-sunburst

# Local LLM (/bot) — OpenAI-compatible API (e.g. Ollama)
LOCAL_LLM_MODEL=gemma4:12b
RETORT_MACHINE_MODEL=google/gemma-4-31b-it
# Use http://host.docker.internal:11434/v1/chat/completions when running via Docker
LOCAL_LLM_CHAT_COMPLETIONS_ENDPOINT=http://localhost:11434/v1/chat/completions

ADMINS=
